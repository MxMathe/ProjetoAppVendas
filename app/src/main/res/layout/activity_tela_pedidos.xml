<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TelaPedidos">

    <TextView
        android:id="@+id/textOla"
        android:layout_width="match_parent"
        android:layout_height="71dp"
        android:background="#FF6F61"
        android:text="Olá Confeiteiro!"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/textpedidos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Veja aqui seus pedidos"
        android:textColor="#000000"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/textOla"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--Quadrados para ser o fundo das informações-->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPedidos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/textpedidos"
        app:layout_constraintBottom_toTopOf="@+id/fundobts1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_pedido" />



    <!--barra de navegação -->
    <View
        android:id="@+id/fundobts1"
        android:layout_width="413dp"
        android:layout_height="60dp"
        android:background="@drawable/container_fundobts"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="1.0"
        tools:ignore="MissingConstraints" />

    <ImageView
        android:id="@+id/imageViewHome"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginStart="45dp"
        app:layout_constraintBottom_toBottomOf="@+id/fundobts1"
        app:layout_constraintStart_toStartOf="@+id/fundobts1"
        app:layout_constraintTop_toTopOf="@+id/fundobts1"
        app:layout_constraintVertical_bias="0.533"
        app:srcCompat="@drawable/home" />

    <ImageView
        android:id="@+id/imageViewAdd"
        android:layout_width="45dp"
        android:layout_height="45dp"
        app:layout_constraintBottom_toBottomOf="@+id/fundobts1"
        app:layout_constraintEnd_toStartOf="@+id/imageViewPerfil"
        app:layout_constraintStart_toEndOf="@+id/imageViewHome"
        app:layout_constraintTop_toTopOf="@+id/fundobts1"
        app:layout_constraintVertical_bias="0.533"
        app:srcCompat="@drawable/maisbranco" />

    <ImageView
        android:id="@+id/imageViewPerfil"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginEnd="45dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/fundobts1"
        app:srcCompat="@drawable/iconebranco" />


</androidx.constraintlayout.widget.ConstraintLayout>